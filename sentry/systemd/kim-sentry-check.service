[Unit]
Description=KIM Sentry deterministic health checks and queued delivery

[Service]
Type=oneshot
Environment=KIM_SENTRY_HOME=/home/faiz/.hermes/profiles/sentry
Environment=PATH=/home/faiz/.local/bin:/usr/bin:/bin
WorkingDirectory=/home/faiz/.hermes/profiles/sentry
ExecStart=/usr/bin/python /home/faiz/KIM/agents/sentry/launch.py check
TimeoutStartSec=120
UMask=0077
